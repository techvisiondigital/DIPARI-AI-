PORT=3001

JWT_SECRET=campaignai_jwt_secret_key_super_secure_2024_v1

# Firebase Admin SDK (required when MOCK_INTEGRATION=false)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_firebase_project_id.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=your_firebase_project_id.firebasestorage.app
FIREBASE_API_KEY=your_firebase_api_key

MOCK_INTEGRATION=false

# Meta (Facebook / Instagram) Marketing API
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:3000/meta/callback
META_WEBHOOK_VERIFY_TOKEN=campaignai_webhook_secret

# AI Models
OPENROUTER_API_KEY=your_openrouter_api_key
# Must be a zero-cost model — "openrouter/auto" routes to PAID models and
# returns HTTP 402 on accounts without credits, silently disabling all AI text.
OPENROUTER_MODEL=minimax/minimax-m3:free
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Groq AI (Fast LLM fallback - llama-3.3-70b-versatile)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Cashfree Payment Gateway Credentials
# Get these from: https://merchant.cashfree.com → Developers → API Keys
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
# CASHFREE_ENVIRONMENT=SANDBOX    ← for testing
# CASHFREE_ENVIRONMENT=PRODUCTION ← for live payments
CASHFREE_ENVIRONMENT=SANDBOX
CASHFREE_API_VERSION=2023-08-01

# Backend & Frontend Public URLs
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Resend (Transactional Email)
RESEND_API_KEY=
